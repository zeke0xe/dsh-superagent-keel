#!/usr/bin/env python3
"""Compare the Jev shadow judge with what dsh-superagent decided, from the state database (read-only).

  scripts/jev-report [--db PATH] [--since ISO-TIME] [--json]

For each Trigger Jev judged: Jev's intake choice and confidence, the injection probability, the impact score, and the
orchestrator's outcome (a decision's kind, a follow-up that reached an open ticket, or nothing yet). The summary counts how
often Jev's choice matches the outcome among decided Triggers, by Jev confidence band, which is the evidence for letting Jev
decide above some confidence (design: 规格v4, experiment A). Outcomes here are the system's, not a person's labels.
"""
import argparse
import json
import os
import sqlite3
import sys

DEFAULT_DB = os.path.expanduser('~/.dsh/state/superagent/orchestrator.sqlite')
# How a decision kind compares with Jev's intake choices.
MATCHES = {'accept': {'accept'}, 'ignore': {'ignore'}, 'ask': {'clarify'}, 'clarify': {'clarify'}}


def rows(db, sql, *args):
    return db.execute(sql, args).fetchall()


def load(db_path, since):
    db = sqlite3.connect(f'file:{db_path}?mode=ro', uri=True)
    out = []
    for key, value in rows(db, "SELECT key, value FROM kv WHERE key LIKE 'jev:%' ORDER BY key"):
        record = json.loads(value)
        if since and record.get('at', '') < since:
            continue
        trigger_id = key[4:]
        trigger = rows(db, 'SELECT value FROM trigger WHERE id=?', trigger_id)
        trigger = json.loads(trigger[0][0]) if trigger else {}
        disposition = rows(db, 'SELECT value FROM disposition WHERE id=?', trigger_id)
        disposition = json.loads(disposition[0][0]) if disposition else {}
        outcome = None
        if disposition.get('decisionId'):
            decision = rows(db, 'SELECT value FROM decision WHERE id=?', disposition['decisionId'])
            outcome = json.loads(decision[0][0]).get('kind') if decision else None
        elif disposition.get('fanout'):
            outcome = 'followup'
        elif disposition.get('filtered'):
            outcome = 'filtered'
        out.append({'trigger': trigger_id, 'at': trigger.get('at', record.get('at')), 'actor': (trigger.get('actor') or {}).get('id'),
                    'text': ' '.join((trigger.get('text') or '').split())[:70], 'jev': record, 'outcome': outcome})
    return out


def band(confidence):
    return '≥0.9' if confidence >= 0.9 else '0.7–0.9' if confidence >= 0.7 else '<0.7'


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument('--db', default=DEFAULT_DB)
    parser.add_argument('--since')
    parser.add_argument('--json', action='store_true')
    args = parser.parse_args()
    items = load(args.db, args.since)
    if args.json:
        json.dump(items, sys.stdout, ensure_ascii=False, indent=2)
        return
    if not items:
        print('Jev has judged no Trigger yet (is a JEV_API_KEY or AI_GATEWAY_API_KEY in $DSH_HOME/.env?).')
        return
    stats = {}
    for item in items:
        jev = item['jev']
        if jev.get('error'):
            print(f"{item['at'][:16]}  {item['actor'] or '?':<16} ERROR {jev['error'][:60]}")
            continue
        intake = jev['intake']
        print(f"{item['at'][:16]}  {item['actor'] or '?':<16} jev={intake['choice']:<7} {intake['confidence']:.2f}  "
              f"inject={jev['injection']:.2f}  impact={jev['impact']['score']:.1f}  outcome={item['outcome'] or '-':<8} {item['text']}")
        if item['outcome'] in MATCHES:
            agree = intake['choice'] in MATCHES[item['outcome']]
            total, same = stats.get(band(intake['confidence']), (0, 0))
            stats[band(intake['confidence'])] = (total + 1, same + agree)
    tokens = sum(item['jev'].get('inputTokens') or 0 for item in items)
    print(f'\n{len(items)} judged, {tokens} input tokens (about ${tokens * 0.042 / 1e6:.6f}).')
    for name in ('≥0.9', '0.7–0.9', '<0.7'):
        if name in stats:
            total, same = stats[name]
            print(f'Jev confidence {name}: agrees with the outcome on {same}/{total} decided Triggers')


if __name__ == '__main__':
    main()
